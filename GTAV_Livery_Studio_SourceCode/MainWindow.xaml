<Window x:Class="GTAVLiveryStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTA V Livery Template Studio - Trình Xuất Mẫu Tem 4K Tự Động (WPF)"
        Icon="app.ico"
        Height="870" Width="1060"
        MinHeight="810" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <!-- Style cho ProgressBar hiển thị tiến độ 0-100% kết hợp dải sóng chuyển động liên tục -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="#11111b"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" Background="Transparent"/>
                                <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                    <Grid ClipToBounds="True">
                                        <!-- Gradient nền xanh Cyan & Xanh lá -->
                                        <Border CornerRadius="6">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#06b6d4" Offset="0.0"/>
                                                    <GradientStop Color="#10b981" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Dải sóng sáng chuyển động liên tục chạy qua phần tiến độ -->
                                        <Border Width="180" HorizontalAlignment="Left" CornerRadius="6">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00000000" Offset="0.0"/>
                                                    <GradientStop Color="#50ffffff" Offset="0.35"/>
                                                    <GradientStop Color="#a0ffffff" Offset="0.5"/>
                                                    <GradientStop Color="#50ffffff" Offset="0.65"/>
                                                    <GradientStop Color="#00000000" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="WaveTransform" X="-200"/>
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="WaveTransform"
                                                                             Storyboard.TargetProperty="X"
                                                                             From="-200" To="650"
                                                                             Duration="0:0:1.3"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Grid>
                                </Decorator>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho ComboBox bo tròn -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#11111b"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="#11111b" BorderBrush="#313244" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0" Background="#181825" BorderBrush="#313244" BorderThickness="1">
                            <Image Source="app.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GTA V Livery Template Studio" FontSize="18" FontWeight="Bold" Foreground="#89b4fa"/>
                            <TextBlock Text="Tự động hóa 100% trích xuất UVMap 1 (Livery Decal) 4K siêu sạch cho các dòng xe GTA V"
                                       FontSize="12" Foreground="#a6adc8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Tech Badges -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1e1e2e" CornerRadius="6" Padding="8,4" Margin="4,0" BorderBrush="#313244" BorderThickness="1">
                        <TextBlock Text="C# .NET 8 WPF" FontSize="11" FontWeight="SemiBold" Foreground="#89b4fa"/>
                    </Border>
                    <Border Background="#1e1e2e" CornerRadius="6" Padding="8,4" Margin="4,0" BorderBrush="#313244" BorderThickness="1">
                        <TextBlock Text="CodeWalker Core" FontSize="11" FontWeight="SemiBold" Foreground="#a6e3a1"/>
                    </Border>
                    <Border Background="#1e1e2e" CornerRadius="6" Padding="8,4" Margin="4,0" BorderBrush="#313244" BorderThickness="1">
                        <TextBlock Text="Blender 5.2 Engine" FontSize="11" FontWeight="SemiBold" Foreground="#f9e2af"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (2 COLUMNS) -->
        <Grid Grid.Row="1" Margin="20,15,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: CONTROLS & LOG (TỰ CUỘN NỘI BỘ TRONG CONSOLE, KHÔNG CUỘN CỘT) -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Drop Zone -->
                    <RowDefinition Height="Auto"/> <!-- Settings -->
                    <RowDefinition Height="Auto"/> <!-- Button -->
                    <RowDefinition Height="Auto"/> <!-- Status & Progress -->
                    <RowDefinition Height="*"/>    <!-- Log Console fills remaining height -->
                </Grid.RowDefinitions>

                <!-- ROW 0: DRAG & DROP ZONE -->
                <Border Grid.Row="0"
                        x:Name="pnlDrop"
                        Background="#1e1e2e"
                        BorderBrush="#89b4fa"
                        BorderThickness="2"
                        CornerRadius="12"
                        Padding="16"
                        AllowDrop="True"
                        Cursor="Hand"
                        DragOver="pnlDrop_DragOver"
                        DragLeave="pnlDrop_DragLeave"
                        Drop="pnlDrop_Drop"
                        MouseLeftButtonUp="pnlDrop_MouseLeftButtonUp">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center" Foreground="#89b4fa"/>
                        <TextBlock Text="KÉO &amp; THẢ FILE .YFT HOẶC .YFT.XML VÀO ĐÂY"
                                   FontSize="13.5" FontWeight="Bold" Foreground="#89b4fa"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="(Hoặc bấm trực tiếp vào ô này để duyệt file xe từ máy tính)"
                                   FontSize="12" Foreground="#a6adc8"
                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <Border Background="#11111b" CornerRadius="8" Padding="12,5" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="lblSelectedFile"
                                       Text="Chưa chọn file nào"
                                       FontSize="12.5" FontStyle="Italic"
                                       Foreground="#f9e2af"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ROW 1: SETTINGS CARD -->
                <Border Grid.Row="1" Background="#1e1e2e" BorderBrush="#313244" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="⚙️ Tùy chọn xuất ảnh" FontSize="13.5" FontWeight="Bold" Foreground="#cdd6f4" Margin="0,0,0,10"/>

                        <!-- Resolution Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Độ phân giải:" VerticalAlignment="Center" FontSize="13" Foreground="#cdd6f4" Margin="0,0,15,0"/>
                            <ComboBox x:Name="cmbResolution" Grid.Column="1" Style="{StaticResource ModernComboBox}" SelectedIndex="0" Foreground="#000">
                                <ComboBoxItem Content="4096 x 4096 (4K - Chuẩn nét căng)" IsSelected="True"/>
                                <ComboBoxItem Content="2048 x 2048 (2K - Nhẹ và nhanh)"/>
                                <ComboBoxItem Content="8192 x 8192 (8K - Siêu chi tiết)"/>
                            </ComboBox>
                        </Grid>

                        <!-- Format Checkboxes -->
                        <StackPanel Orientation="Vertical">
                            <CheckBox x:Name="chkPhotoshop" IsChecked="True" Margin="0,3" Cursor="Hand">
                                <TextBlock Text="Bản vẽ Photoshop (PNG Nền trong suốt - Dễ kéo vào vẽ tem)" FontSize="12.5" Foreground="#a6e3a1"/>
                            </CheckBox>
                            <CheckBox x:Name="chkPreview" IsChecked="True" Margin="0,3" Cursor="Hand">
                                <TextBlock Text="Bản xem trước Preview (PNG Nền tối - Đường nét màu Cyan)" FontSize="12.5" Foreground="#89dceb"/>
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ROW 2: ACTION BUTTON -->
                <Button Grid.Row="2"
                        x:Name="btnStart"
                        Style="{StaticResource PrimaryButton}"
                        Height="46"
                        Margin="0,12,0,0"
                        Click="btnStart_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="BẮT ĐẦU TRÍCH XUẤT UV TEMPLATE" FontSize="13.5" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- ROW 3: STATUS & PROGRESS (TIẾN ĐỘ 0-100% VÀ SÓNG CYAN/XANH LÁ) -->
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="lblStatus"
                                   Text="Trạng thái: Sẵn sàng."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#10b981"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblPercent"
                                   Grid.Column="1"
                                   Text="0%"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#06b6d4"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar x:Name="progressBar"
                                 Style="{StaticResource ModernProgressBar}"
                                 Height="11"
                                 Margin="0,6,0,0"
                                 Value="0"
                                 Maximum="100"/>
                </StackPanel>

                <!-- ROW 4: LOG CONSOLE (TỰ CUỘN NỘI BỘ, CHIẾM TRỌN CHIỀU CAO CÒN LẠI) -->
                <Border Grid.Row="4" Background="#11111b" BorderBrush="#313244" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📋 Nhật ký tiến trình (Real-time Console)" FontSize="12.5" FontWeight="Bold" Foreground="#a6adc8" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="1"
                                 x:Name="txtLog"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="#a6e3a1"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="11.5"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: PREVIEW 1:1 SQUARE, QUICK ACTIONS & RESULT BOX -->
            <Border Grid.Column="1" Background="#1e1e2e" BorderBrush="#313244" BorderThickness="1" CornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="Auto"/> <!-- 1:1 Square Box -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                        <RowDefinition Height="Auto"/> <!-- Hint Card -->
                        <RowDefinition Height="*"/>    <!-- Result / Status Box -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🖼️ Ảnh mẫu UV vừa tạo (Tỉ lệ 1:1)" FontSize="14" FontWeight="Bold" Foreground="#cdd6f4" Margin="0,0,0,10"/>

                    <!-- PREVIEW IMAGE BOX (KHUNG HIỂN THỊ CHUẨN 1:1 VUÔNG VỨC) -->
                    <Border Grid.Row="1"
                            Width="370" Height="370"
                            HorizontalAlignment="Center"
                            Background="#11111b"
                            BorderBrush="#313244"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <Grid>
                            <StackPanel x:Name="pnlPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🎨" FontSize="44" HorizontalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="(Chưa có ảnh kết quả 1:1)" FontSize="12.5" Foreground="#6c7086" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Image x:Name="imgPreview" Stretch="Uniform" Margin="4"/>
                        </Grid>
                    </Border>

                    <!-- ACTION BUTTONS -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnOpenFolder" Grid.Column="0" Style="{StaticResource ModernButton}" Margin="0,0,6,0" Click="btnOpenFolder_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" Margin="0,0,6,0"/>
                                <TextBlock Text="Mở thư mục"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnOpenImage" Grid.Column="1" Style="{StaticResource ModernButton}" Margin="6,0,0,0" Click="btnOpenImage_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖼️" Margin="0,0,6,0"/>
                                <TextBlock Text="Xem ảnh gốc"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- HINT CARD (LƯU Ý QUAN TRỌNG & THÔNG TIN HỖ TRỢ) -->
                    <Border Grid.Row="3" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="💡 LƯU Ý &amp; THÔNG TIN SỬ DỤNG:" FontSize="12" FontWeight="Bold" Foreground="#f9e2af" Margin="0,0,0,6"/>

                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0">
                                <Run Foreground="#cdd6f4" FontWeight="SemiBold" Text="1. Yêu cầu hệ thống: "/>
                                <Run Foreground="#a6adc8" Text="Cần cài đặt Blender (5.2+) và kích hoạt Addon Sollumz để xử lý 3D ngầm."/>
                            </TextBlock>

                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                                <Run Foreground="#cdd6f4" FontWeight="SemiBold" Text="2. Miễn trừ trách nhiệm: "/>
                                <Run Foreground="#a6adc8" Text="Công cụ miễn phí phục vụ cộng đồng modder, người dùng tự chịu trách nhiệm khi sử dụng."/>
                            </TextBlock>

                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                                <Run Foreground="#cdd6f4" FontWeight="SemiBold" Text="3. Độ tương thích: "/>
                                <Run Foreground="#a6adc8" Text="Không đảm bảo 100% mọi xe (một số xe gốc Rockstar khóa nén hoặc không có UV tem riêng)."/>
                            </TextBlock>

                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0">
                                <Run Foreground="#cdd6f4" FontWeight="SemiBold" Text="5. Tác giả &amp; Bản quyền: "/>
                                <Run Foreground="#FFC1A41B" FontWeight="Bold" Text="SonixGTA - KAI Media - Sonimax Studio"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- RESULT / STATUS NOTIFICATION BOX (DỰ PHÒNG THÔNG BÁO 'ĐÃ XONG' HOẶC 'ERROR') -->
                    <Border Grid.Row="4"
                            x:Name="pnlResultBox"
                            Background="#181825"
                            BorderBrush="#313244"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,8,0,0"
                            VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="txtResultIcon"
                                       Text="ℹ️"
                                       FontSize="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtResultTitle"
                                           Text="CHỜ XỬ LÝ (IDLE)"
                                           FontSize="12.5"
                                           FontWeight="Bold"
                                           Foreground="#89b4fa"/>
                                <TextBlock x:Name="txtResultSub"
                                           Text="Hãy chọn hoặc kéo thả file xe để bắt đầu xuất tem."
                                           FontSize="11"
                                           Foreground="#a6adc8"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>